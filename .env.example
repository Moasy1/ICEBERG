# Database
MONGODB_URI=mongodb://localhost:27017/iceberg_cms
# For production, use MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/iceberg_cms

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# API Configuration
API_BASE_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# CMS Configuration
CMS_ADMIN_EMAIL=admin@iceberg.agency
CMS_ADMIN_PASSWORD=admin123456

# Contact Form
CONTACT_EMAIL=info@iceberg.agency

# Environment
NODE_ENV=development
