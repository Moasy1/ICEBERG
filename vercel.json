{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/parallax", "destination": "/parallax/index.html" },
    { "source": "/birthday-campaign", "destination": "/birthday-campaign.html" },
    { "source": "/((?!api/).*)", "destination": "/$1.html" }
  ]
}
